# =============================================================================
# Core Hub IA — Configuração Centralizada
# =============================================================================

# ── Servidor ─────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── GPU ──────────────────────────────────────────────────────────────────
# Habilitar uso de GPU (VRAM). Desabilite para servidores apenas CPU+RAM.
ENABLE_GPU=false

# ── Recursos ─────────────────────────────────────────────────────────────
# Percentual máximo de RAM/CPU que o Hub pode consumir (0.0 a 1.0)
RESOURCE_USAGE_LIMIT=0.6
# Número máximo de requisições simultâneas ao Ollama
MAX_CONCURRENT_REQUESTS=2

# ── Ollama ───────────────────────────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434

# ── Diretórios ───────────────────────────────────────────────────────────
VAR_DIR=./var
CONTEXT_DIR=./var/context
DBLANCE_DIR=./var/dblance

# ── Modelos padrão ───────────────────────────────────────────────────────
# Modelo usado para chat/texto genérico
DEFAULT_TEXT_MODEL=qwen2.5:7b
# Modelo alternativo (menor/mais rápido)
FALLBACK_TEXT_MODEL=phi3.5
# Modelo para embeddings/RAG
EMBEDDING_MODEL=bge-m3
